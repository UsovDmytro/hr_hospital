<odoo>
    <data noupdate="1">

        <record id="hr_hospital_rule_patient" model="ir.rule">
            <field name="name">Patients can only view own visits</field>
            <field name="model_id" ref="model_hr_hospital_visit"/>
            <field name="domain_force">[('patient_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hospital_patient'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_hospital_rule_intern" model="ir.rule">
            <field name="name">Interns can only view and edit own visits</field>
            <field name="model_id" ref="model_hr_hospital_visit"/>
            <field name="domain_force">[('doctor_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hospital_intern'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_hospital_rule_doctor" model="ir.rule">
            <field name="name">Doctors can only view and edit their visits and those of their interns</field>
            <field name="model_id" ref="model_hr_hospital_visit"/>
            <field name="domain_force">[('doctor_id.d_main_doctor_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hospital_doctor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_hospital_rule_manager" model="ir.rule">
            <field name="name">Manager can view all visits</field>
            <field name="model_id" ref="model_hr_hospital_visit"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_hospital_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_hospital_rule_admin" model="ir.rule">
            <field name="name">Administrators have full rights</field>
            <field name="model_id" ref="model_hr_hospital_visit"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_hospital_admin'))]"/>
        </record>

    </data>
</odoo>